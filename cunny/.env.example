# cunny backend example env
# Copy this to .env and edit values for your environment

# Server port
PORT=3000

# Body parsing limit for express.json (e.g., 16kb, 64kb)
EXPRESS_BODY_LIMIT=16kb

# Max bytes allowed for push payload/event
PUSH_PAYLOAD_MAX_BYTES=4096

# Max devices allowed per /_matrix/push/v1/notify request
MAX_DEVICES_PER_NOTIFY=200

# Global rate limit (window and max requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Admin rate limit
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=30

# Subscribe rate limit
SUBSCRIBE_RATE_LIMIT_WINDOW_MS=60000
SUBSCRIBE_RATE_LIMIT_MAX=60

# Logging
LOG_LEVEL=info

# Optional: provide push gateway secret and admin API keys via env or data files
# PUSH_GATEWAY_SECRET=your_secret_here
# ADMIN_API_KEYS=key1,key2
